{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CartoonNotebook",
  "version": "0.1.0",
  "identifier": "com.paperfalcon.cartoonnotebook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "动漫档案馆",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}